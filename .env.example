# Supabase Server-Side Credentials (Configure in Netlify Environment Variables for Production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI API Key (server-side only; configure in Netlify Environment Variables for Production)
# Use a Google AI Studio key. Do not use Antigravity CLI, OAuth, session, or VITE_ credentials.
GEMINI_API_KEY=

# JWT Secret Key
JWT_SECRET=
